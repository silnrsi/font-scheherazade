<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="../tools/ftml.xsl" type="text/xsl"?>
<ftml version="1.0">
  <head>
    <comment>Left is the reference glyph from Version 4.5 of Scheherazade. The right two are Regular and Bold for the revised glyphs. Light green: a character is new in this version of the font. The little corner brackets show the amount of sidebearings on each honorific, as well as the baseline for the font. The fancy brackets are there to show you what they look like with the brackets.</comment>
    <fontscale>350</fontscale>
    <fontsrc label="4.5">url(../references/v4.500/ScheherazadeNew-Regular.ttf)</fontsrc>
    <fontsrc label="Reg">url(../results/ScheherazadeNew-Regular.ttf)</fontsrc>
    <fontsrc label="Med">url(../results/ScheherazadeNew-Medium.ttf)</fontsrc>
    <fontsrc label="SeBld">url(../results/ScheherazadeNew-SemiBold.ttf)</fontsrc>
    <fontsrc label="Bold">url(../results/ScheherazadeNew-Bold.ttf)</fontsrc>
    <styles>
   </styles>
    <title>Honorifics</title>
    <widths string="20%"/>
  </head>
  <testgroup label="Encoded characters">
